{
  "name": "diplomaps",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Start a war without firing a shot. A candlelit diplomacy game where AI rulers remember every word you say.",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "simulate": "tsx scripts/simulate.ts",
    "generate:greeting-voices": "tsx scripts/generate-greeting-voices.ts",
    "playtest": "node scripts/playtest.mjs"
  },
  "dependencies": {
    "d3-delaunay": "^6.0.4",
    "howler": "^2.2.4",
    "motion": "^13.4.4",
    "openai": "^7.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3-delaunay": "^6.0.4",
    "@types/howler": "^2.2.13",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1"
  }
}
