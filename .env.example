# Copy this file to .env.local and add your key. Never commit .env.local.
OPENAI_API_KEY=
# ElevenLabs key. Nation voice IDs are configured in src/engine/config.ts.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
# Fast model: audiences, nation actions, extraction.
MODEL_FAST=gpt-5.6-luna
# Rich model: chronicle, ruler verdicts, epilogue.
MODEL_RICH=gpt-5.6-terra
